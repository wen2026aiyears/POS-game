    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Arial', sans-serif; background-color: #f4f6f9; padding: 20px; display: flex; flex-direction: column; align-items: center; }
        
        .header { text-align: center; margin-bottom: 20px; }
        .header h1 { color: #00704A; font-size: 28px; margin-bottom: 5px; }
        .timer { font-size: 18px; color: #ff7675; font-weight: bold; }
        .difficulty-selector { margin-top: 10px; }
        .difficulty-btn { background: #e0e0e0; border: none; padding: 8px 12px; margin: 0 5px; border-radius: 15px; cursor: pointer; font-weight: bold; transition: 0.2s; }
        .difficulty-btn.active { background: #00704A; color: white; }
        
        .game-container { display: flex; width: 1200px; background: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border-radius: 12px; overflow: hidden; }
        
        .pos-screen { flex: 2.5; padding: 20px; display: flex; flex-direction: column; border-right: 2px solid #e0e0e0; overflow-y: auto; max-height: 90vh; }
        
        .sidebar { flex: 1; padding: 20px; background: #00704A; color: #fff; display: flex; flex-direction: column; justify-content: space-between; overflow-y: auto; max-height: 90vh; }
        
        /* 分類標籤 */
        .category-tabs { display: flex; gap: 8px; margin-bottom: 15px; flex-wrap: wrap; }
        .category-btn { background: #e0e0e0; border: none; padding: 10px 16px; border-radius: 20px; cursor: pointer; font-weight: bold; transition: 0.2s; color: #333; font-size: 12px; }
        .category-btn.active { background: #00704A; color: white; }
        .category-btn:hover { background: #d0d0d0; }
        .category-btn.active:hover { background: #005237; }
        
        /* 菜單網格 */
        .menu-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 20px; }
        .menu-item { background: #00704A; color: white; border: none; padding: 12px; font-size: 12px; border-radius: 6px; cursor: pointer; transition: 0.2s; font-weight: bold; text-align: center; min-height: 60px; }
        .menu-item:hover { background: #005237; transform: scale(1.02); }
        .menu-item-name { font-size: 11px; }
        .menu-item-price { font-size: 13px; margin-top: 4px; }
        .menu-item-tier { font-size: 9px; color: #ffd700; margin-top: 2px; }
        
        /* 規格區 */
        .option-section { background: #f8f9fa; padding: 12px; border-radius: 6px; margin-bottom: 10px; border: 1px solid #dee2e6; }
        .option-section strong { color: #333; font-size: 13px; }
        .option-group { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
        .opt-btn { background: #fff; border: 1px solid #ccc; padding: 6px 10px; border-radius: 4px; cursor: pointer; font-size: 11px; transition: 0.2s; }
        .opt-btn:hover { border-color: #00704A; }
        .opt-btn.active { background: #00704A; color: white; border-color: #00704A; font-weight: bold; }
        
        /* 購物車 */
        .cart-list { border: 1px solid #ddd; height: 180px; overflow-y: auto; background: #fff; padding: 10px; border-radius: 6px; margin-top: 10px; }
        .cart-item { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px dashed #eee; font-size: 12px; color: #333; }
        .cart-item-name { flex: 1; font-size: 11px; }
        .cart-item-price { text-align: right; min-width: 50px; font-weight: bold; }
        
        /* 按鈕區 */
        .action-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: auto; }
        .btn { padding: 12px; border: none; border-radius: 6px; font-size: 14px; font-weight: bold; cursor: pointer; transition: 0.2s; }
        .btn-clear { background: #e74c3c; color: white; }
        .btn-clear:hover { background: #c0392b; }
        .btn-submit { background: #27ae60; color: white; }
        .btn-submit:hover { background: #229954; }
        .btn-add { background: #9b59b6; color: white; margin-top: 10px; }
        .btn-add:hover { background: #8e44ad; }
        
        /* 任務框 */
        .task-box { background: #00704A; padding: 15px; border-radius: 8px; margin-bottom: 15px; font-size: 13px; font-weight: bold; border-left: 5px solid #005237; color: white; }
        .task-item { margin: 6px 0; padding: 6px; background: rgba(255,255,255,0.2); border-radius: 4px; font-size: 12px; }
        .payment-mode { background: rgba(255,215,0,0.3); border-left: 5px solid #ffd700; margin-top: 8px; padding: 8px; border-radius: 4px; }
        
        /* 分數面板 */
        .score-board { font-size: 18px; margin-bottom: 10px; font-weight: bold; color: #fff; }
        .score-value { font-size: 28px; color: #ffd700; }
        
        /* 支付模式選擇 */
        .payment-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; }
        .payment-modal.show { display: flex; }
        .payment-content { background: white; padding: 30px; border-radius: 12px; max-width: 500px; text-align: center; }
        .payment-content h2 { color: #00704A; margin-bottom: 20px; }
        .payment-options { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px; }
        .payment-btn { padding: 15px; border: 2px solid #ddd; border-radius: 8px; cursor: pointer; background: #f8f9fa; transition: 0.2s; font-weight: bold; }
        .payment-btn:hover { border-color: #00704A; background: #e8f5e9; }
        .payment-icon { font-size: 24px; margin-bottom: 8px; }
        
        /* 隱藏元素 */
        .hidden { display: none !important; }
        
        /* 響應式 */
        @media (max-width: 1400px) {
            .menu-grid { grid-template-columns: repeat(3, 1fr); }
            .game-container { width: 100%; }
        }
    </style>
</head>
