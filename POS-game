                { name: '一份鹹焦糖糖漿', price: 10, category: 'customization', type: '糖漿', tier: 'P1' },
                { name: '一份薄荷糖漿', price: 10, category: 'customization', type: '糖漿', tier: 'P1' },
                { name: '一份抹茶液', price: 15, category: 'customization', type: '特調醬料', tier: 'P1' },
                { name: '一份黑糖糖醬', price: 15, category: 'customization', type: '特調醬料', tier: 'P1' },
                { name: '一份蜂蜜爆珠粒', price: 15, category: 'customization', type: '特調醬料', tier: 'P1' },
                { name: '鮮奶油', price: 10, category: 'customization', type: '配料', tier: 'P1' },
                { name: '一份可可碎片', price: 10, category: 'customization', type: '配料', tier: 'P1' },
                { name: '加一份濃度', price: 15, category: 'customization', type: '濃縮', tier: 'P1' },
                { name: '加一份咖啡', price: 15, category: 'customization', type: '濃縮', tier: 'P1' },
                { name: '客製燕麥奶', price: 20, category: 'customization', type: '植物奶', tier: 'P1' },
                { name: '客製杏仁奶', price: 20, category: 'customization', type: '植物奶', tier: 'P1' },
            ]
        };

        // 遊戲狀態
        const gameState = {
            currentCategory: 'hot',
            currentTask: {},
            currentSelection: { name: '', price: 0, sugar: '正常糖', ice: '正常冰', temp: '熱' },
            cart: [],
            score: 0,
            timeLeft: 90,
            gameInterval: null,
            difficulty: 'easy',
            selectedPaymentMode: null
        };

        // 選項資料
        const options = {
            sugar: ['正常糖', '少糖', '半糖', '微糖', '無糖'],
            ice: ['正常冰', '少冰', '微冰', '去冰', '完全去冰'],
            temp: ['熱', '溫']
        };

        // 支付方式資訊
        const paymentModes = {
            cash: { name: '現金', instruction: '顧客支付現金，請核對金額並計算找零...' },
            card: { name: '信用卡', instruction: '感應信用卡或行動支付卡片...' },
            mobile: { name: '行動支付', instruction: '掃描顧客支付 QR Code（Line Pay、街口、OPEN Pay）' },
            eticket: { name: '電子票證', instruction: '感應悠遊卡、一卡通或 icash...' },
            egift: { name: '隨行卡eGift', instruction: '感應隨行卡或掃 APP 條碼扣款...' },
            coupon: { name: '優惠券', instruction: '掃描或輸入優惠券代碼...' }
        };

        // 設定難度
        function setDifficulty(level) {
            gameState.difficulty = level;
            document.querySelectorAll('.difficulty-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            clearCart();
            gameState.score = 0;
            document.getElementById('score').innerText = 0;
        }

        // 初始化遊戲
        function startGame() {
            renderMenuItems(gameState.currentCategory);
            renderOptions();
            generateTask();
            gameState.gameInterval = setInterval(() => {
                gameState.timeLeft--;
                document.getElementById('time-left').innerText = gameState.timeLeft;
                if (gameState.timeLeft <= 0) {
                    clearInterval(gameState.gameInterval);
                    alert(`遊戲結束！您的最終得分是：${gameState.score} 分`);
                    location.reload();
                }
            }, 1000);
        }

        // 切換分類
        function switchCategory(category) {
            gameState.currentCategory = category;
            document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            renderMenuItems(category);
            
            // 顯示/隱藏冰塊選項
            const iceSection = document.getElementById('ice-section');
            const tempSection = document.getElementById('temp-section');
            
            if (category === 'food' || category === 'bundle' || category === 'customization') {
                iceSection.classList.add('hidden');
                tempSection.classList.remove('hidden');
            } else {
                iceSection.classList.remove('hidden');
                tempSection.classList.add('hidden');
            }
        }

        // 渲染菜單項目
        function renderMenuItems(category) {
            const grid = document.getElementById('menu-grid');
            grid.innerHTML = '';
            menuData[category].forEach(item => {
                const btn = document.createElement('button');
                btn.className = 'menu-item';
                btn.innerHTML = `<div class="menu-item-name">${item.name}</div><div class="menu-item-price">$${item.price}</div><div class="menu-item-tier">${item.tier || ''}</div>`;
                btn.onclick = () => selectProduct(item.name, item.price);
                grid.appendChild(btn);
            });
        }

        // 渲染規格選項
        function renderOptions() {
            // 甜度
            const sugarGroup = document.getElementById('sugar-group');
            sugarGroup.innerHTML = '';
            options.sugar.forEach((sugar, idx) => {
                const btn = document.createElement('button');
                btn.className = `opt-btn ${idx === 0 ? 'active' : ''}`;
                btn.innerText = sugar;
                btn.onclick = () => setOption('sugar', sugar);
                sugarGroup.appendChild(btn);
            });

            // 冰塊
            const iceGroup = document.getElementById('ice-group');
            iceGroup.innerHTML = '';
            options.ice.forEach((ice, idx) => {
                const btn = document.createElement('button');
                btn.className = `opt-btn ${idx === 0 ? 'active' : ''}`;
                btn.innerText = ice;
                btn.onclick = () => setOption('ice', ice);
                iceGroup.appendChild(btn);
            });
        }

        // 選擇商品
        function selectProduct(name, price) {
            gameState.currentSelection = { name, price, sugar: '正常糖', ice: '正常冰', temp: '熱' };
        }

        // 選擇規格
        function setOption(type, value) {
            gameState.currentSelection[type] = value;
            const container = document.getElementById(`${type}-group`);
            const buttons = container.getElementsByClassName('opt-btn');
            for (let btn of buttons) {
                if (btn.innerText === value) btn.classList.add('active');
                else btn.classList.remove('active');
            }
        }

        // 加入購物車
        function addToCart() {
            if (!gameState.currentSelection.name) {
                alert('請先選擇商品！');
                return;
            }
            gameState.cart.push({ ...gameState.currentSelection });
            updateCartDisplay();
        }

        // 更新購物車顯示
        function updateCartDisplay() {
            const container = document.getElementById('cart-display');
            container.innerHTML = '';
            let total = 0;
            gameState.cart.forEach((item, idx) => {
                total += item.price;
                const div = document.createElement('div');
                div.className = 'cart-item';
                
                const category = gameState.currentCategory;
                let details = '';
                if (category === 'hot' || category === 'cold') {
                    details = `(${item.sugar}/${item.ice})`;
                } else if (category === 'food' || category === 'bundle') {
                    details = `(${item.temp})`;
                }
                
                div.innerHTML = `
                    <span class="cart-item-name">${item.name} ${details}</span>
                    <span class="cart-item-price">$${item.price}</span>
                `;
                container.appendChild(div);
            });
            document.getElementById('total-price').innerText = total;
        }

        // 清除購物車
        function clearCart() {
            gameState.cart = [];
            updateCartDisplay();
        }

        // 隨機出題
        function generateTask() {
            let categories = ['hot', 'cold', 'food', 'bundle'];
            
            // 根據難度調整題目範圍
            if (gameState.difficulty === 'easy') {
                categories = ['hot', 'cold']; // 只出飲料
            } else if (gameState.difficulty === 'normal') {
                categories = ['hot', 'cold', 'food']; // 飲料 + 食品
            }
            
            const randomCat = categories[Math.floor(Math.random() * categories.length)];
            const items = menuData[randomCat];
            const randomItem = items[Math.floor(Math.random() * items.length)];
            
            let task = { 
                name: randomItem.name, 
                price: randomItem.price,
                category: randomCat,
                tier: randomItem.tier,
                sugar: randomCat === 'hot' || randomCat === 'cold' ? options.sugar[Math.floor(Math.random() * options.sugar.length)] : null,
                ice: randomCat === 'hot' || randomCat === 'cold' ? options.ice[Math.floor(Math.random() * options.ice.length)] : null,
                temp: randomCat === 'food' || randomCat === 'bundle' ? options.temp[Math.floor(Math.random() * options.temp.length)] : null,
                paymentMode: gameState.difficulty === 'hard' ? Object.keys(paymentModes)[Math.floor(Math.random() * Object.keys(paymentModes).length)] : null
            };
            
            gameState.currentTask = task;
            updateTaskDisplay();
        }

        // 更新任務顯示
        function updateTaskDisplay() {
            const task = gameState.currentTask;
            const taskText = document.getElementById('task-text');
            
            let details = '';
            if (task.category === 'hot' || task.category === 'cold') {
                details = `<div class="task-item">甜度：${task.sugar}</div><div class="task-item">冰塊：${task.ice}</div>`;
            } else {
                details = `<div class="task-item">備註：${task.temp}</div>`;
            }
            
            let paymentInfo = '';
            if (task.paymentMode) {
                paymentInfo = `<div class="payment-mode">💳 支付方式：${paymentModes[task.paymentMode].name}</div>`;
            }
            
            taskText.innerHTML = `
                <div class="task-item" style="background: rgba(255,255,255,0.3); font-size: 14px;">👉 ${task.name}</div>
                ${details}
                <div class="task-item">價格：$${task.price}</div>
                ${paymentInfo}
            `;
        }

        // 檢查答案
        function checkAnswer() {
            if (gameState.cart.length === 0) {
                alert('購物車為空，請加入商品！');
                return;
            }

            if (gameState.cart.length === 1) {
                const item = gameState.cart[0];
                const task = gameState.currentTask;
                
                if (item.name === task.name && item.price === task.price) {
                    // 檢查規格
                    if (task.category === 'hot' || task.category === 'cold') {
                        if (item.sugar === task.sugar && item.ice === task.ice) {
                            // 高級難度需檢查支付方式
                            if (gameState.difficulty === 'hard' && task.paymentMode) {
                                showPaymentModal();
                            } else {
                                correctAnswer();
                            }
                        } else {
                            alert('❌ 規格錯誤！請確認甜度和冰塊的設定');
                            clearCart();
                        }
                    } else {
                        // 食品/組合
                        if (gameState.difficulty === 'hard' && task.paymentMode) {
                            showPaymentModal();
                        } else {
                            correctAnswer();
                        }
                    }
                } else {
                    alert('❌ 商品或價格錯誤！');
                    clearCart();
                }
            } else {
                alert('❌ 購物車內應只有一項商品！');
            }
        }

        // 顯示支付模式選擇彈窗
        function showPaymentModal() {
            document.getElementById('payment-modal').classList.add('show');
            document.getElementById('payment-instruction').innerText = '請選擇正確的支付方式：';
        }

        // 隱藏支付模式彈窗
        function hidePaymentModal() {
            document.getElementById('payment-modal').classList.remove('show');
        }

        // 選擇支付方式
        function selectPaymentMode(mode) {
            gameState.selectedPaymentMode = mode;
            document.querySelectorAll('.payment-btn').forEach(btn => btn.style.background = '#f8f9fa');
            event.target.closest('.payment-btn').style.background = '#e8f5e9';
            
            const instruction = paymentModes[mode].instruction;
            document.getElementById('payment-instruction').innerText = instruction;
        }

        // 完成支付
        function completePayment() {
            if (!gameState.selectedPaymentMode) {
                alert('請選擇支付方式！');
                return;
            }

            const task = gameState.currentTask;
            if (gameState.selectedPaymentMode === task.paymentMode) {
                hidePaymentModal();
                correctAnswer();
            } else {
                alert(`❌ 支付方式錯誤！應該使用 ${paymentModes[task.paymentMode].name}`);
                gameState.selectedPaymentMode = null;
            }
        }

        // 答題正確
        function correctAnswer() {
            const baseScore = 10;
            let bonus = 0;
            
            // 根據難度給予加分
            if (gameState.difficulty === 'normal') bonus = 5;
            if (gameState.difficulty === 'hard') bonus = 10;
            
            const totalScore = baseScore + bonus;
            gameState.score += totalScore;
            document.getElementById('score').innerText = gameState.score;
            
            let message = `🎯 點單正確！得分 +${totalScore}`;
            alert(message);
            clearCart();
            generateTask();
        }

        // 啟動遊戲
        window.onload = startGame;
    </script>
</body>
</html>